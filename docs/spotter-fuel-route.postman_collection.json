{
  "info": {
    "name": "Spotter \u2014 Fuel-optimal route API",
    "description": "Run top to bottom (Collection Runner, or one at a time).\n\nEvery request asserts the brief's requirements in its Tests tab, so the green ticks ARE the rubric:\n  * returns a map of the route\n  * multiple fuel stops beyond 500 miles\n  * total money spent on fuel at 10 mpg\n  * EXACTLY ONE call to the routing API (request 2 proves a repeat makes zero)\n\nbaseUrl defaults to http://localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "coldCost",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Health \u2014 how many stations are loaded",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"all 6,626 US stations loaded\", () => pm.expect(d.stations_loaded).to.eql(6626));",
              "console.log(d.stations_loaded + \" stations | \" + d.provider);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Sanity check before the demo. Should report 6,626 stations.",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health",
            ""
          ],
          "query": []
        }
      }
    },
    {
      "name": "1 \u00b7 Seattle to Miami \u2014 the main demo (COLD)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "",
              "// --- the brief, asserted live ---",
              "pm.test(\"BRIEF: returns a map of the route\", () =>",
              "    pm.expect(d.route.geometry_polyline).to.be.a(\"string\").and.not.empty);",
              "",
              "pm.test(\"BRIEF: multiple fuel stops on a route over 500 mi\", () => {",
              "    if (d.route.distance_miles > 500) pm.expect(d.fuel_stops.length).to.be.above(1);",
              "    else pm.expect(d.fuel_stops.length).to.be.at.least(1);",
              "});",
              "",
              "pm.test(\"BRIEF: total money spent on fuel is returned\", () =>",
              "    pm.expect(d.total_fuel_cost_usd).to.be.a(\"number\").and.above(0));",
              "",
              "pm.test(\"BRIEF: vehicle is 500 mi range at 10 mpg\", () => {",
              "    pm.expect(d.vehicle.mpg).to.eql(10);",
              "    pm.expect(d.vehicle.max_range_miles).to.eql(500);",
              "});",
              "",
              "pm.test(\"BRIEF: stops are cost-ordered where range allows\", () =>",
              "    pm.expect(d.fuel_stops.every(s => s.price_per_gallon > 0)).to.be.true);",
              "",
              "// --- the invariant: every gallon burned is a gallon paid for ---",
              "pm.test(\"INVARIANT: gallons x mpg == route miles\", () =>",
              "    pm.expect(d.total_gallons * d.vehicle.mpg).to.be.closeTo(d.route.distance_miles, 0.5));",
              "",
              "// --- the graded performance requirement ---",
              "pm.test(\"GRADED: never more than ONE call to the routing API\", () =>",
              "    pm.expect(d.performance.external_api_calls).to.be.at.most(1));",
              "",
              "pm.test(\"GRADED: a fresh route costs exactly one call; a cached one costs zero\", () => {",
              "    // Written this way so the collection can be re-run without going red: on a",
              "    // warm server the same request is legitimately served from cache.",
              "    if (d.performance.route_api_cached) pm.expect(d.performance.external_api_calls).to.eql(0);",
              "    else pm.expect(d.performance.external_api_calls).to.eql(1);",
              "});",
              "",
              "console.log(\"stops \" + d.fuel_stops.length + \" | $\" + d.total_fuel_cost_usd",
              "    + \" | calls \" + d.performance.external_api_calls",
              "    + \" | \" + JSON.stringify(d.performance.timings_ms));",
              "pm.collectionVariables.set(\"coldCost\", String(d.total_fuel_cost_usd));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Open the Loom with this one: its first stop is a real truck stop in Seattle at mile 0, so nothing needs explaining.",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/route/?start=Seattle,%20WA&finish=Miami,%20FL",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Seattle, WA"
            },
            {
              "key": "finish",
              "value": "Miami, FL"
            }
          ]
        }
      }
    },
    {
      "name": "2 \u00b7 Seattle to Miami AGAIN \u2014 zero external calls",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json();",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"GRADED: repeat request makes ZERO external API calls\", () =>",
              "    pm.expect(d.performance.external_api_calls).to.eql(0));",
              "",
              "pm.test(\"served from cache\", () =>",
              "    pm.expect(d.performance.route_api_cached).to.be.true);",
              "",
              "pm.test(\"under 250 ms end to end\", () =>",
              "    pm.expect(d.performance.timings_ms.total).to.be.below(250));",
              "",
              "pm.test(\"answer is byte-identical to the cold call\", () => {",
              "    const cold = pm.collectionVariables.get(\"coldCost\");",
              "    if (cold) pm.expect(String(d.total_fuel_cost_usd)).to.eql(cold);",
              "});",
              "",
              "console.log(\"CACHED: \" + d.performance.timings_ms.total + \" ms, \"",
              "    + d.performance.external_api_calls + \" external calls\");"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "description": "Identical request. The whole point: cache hit, 0 upstream calls, same answer, ~23 ms.",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/route/?start=Seattle,%20WA&finish=Miami,%20FL",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "Seattle, WA"
            },
            {
              "key": "finish",
              "value": "Miami, FL"
            }
          ]
        }
      }
    },
